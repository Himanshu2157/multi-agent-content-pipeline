{
  "name": "@contentforge/database",
  "version": "1.0.0",
  "type": "module",
  "description": "Database package for ContentForge with Prisma",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
